{
  "name": "@inbox/ui",
  "version": "0.1.0",
  "description": "Inbox dev tooling UI — Operator's Console",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
